<Window x:Class="WpfAppTRPO.Views.BookEditAdd"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppTRPO.Views"
        mc:Ignorable="d"
        Background="#D37EAB"
        Title="Редактирование" Height="450" Width="337" WindowStartupLocation="CenterScreen" WindowStyle="None">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#9D5D91"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FCC165"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Библиотечный шифр" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="1" Content="Название" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="2" Content="Автор" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="3" Content="Издательство" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="4" Content="Место публикации" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="5" Content="Год публикации" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <Label Grid.Row="6" Content="Количество копий" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            <TextBox x:Name="textBoxLibCode" Grid.Column="1" Grid.Row="0" TextWrapping="Wrap" MaxLength="3" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120" PreviewTextInput="TextBox_PreviewTextInput" ToolTip="Первые две цифры - номер стеллажа, последняя цифра - номер полки."/>
            <TextBox x:Name="textBoxTitle" Grid.Column="1" Grid.Row="1" TextWrapping="Wrap" MaxLength="150" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120"/>
            <ComboBox x:Name="comboBoxAuthors" Grid.Column="1" Grid.Row="2" DisplayMemberPath="Name" SelectedValuePath="Id" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120"/>
            <TextBox x:Name="textBoxPublisher" Grid.Column="1" Grid.Row="3" TextWrapping="Wrap" MaxLength="100" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120"/>
            <TextBox x:Name="textBoxPublicationPlace" Grid.Column="1" Grid.Row="4" TextWrapping="Wrap" MaxLength="50" VerticalAlignment="Center" HorizontalAlignment="Left" Width="120"/>
            <TextBox x:Name="textBoxPublicationYear" Grid.Column="1" Grid.Row="5" TextWrapping="Wrap" MaxLength="4" VerticalAlignment="Center" HorizontalAlignment="Left" Width="40" PreviewTextInput="TextBox_PreviewTextInput"/>
            <TextBox x:Name="textBoxCopies" Grid.Column="1" Grid.Row="6" TextWrapping="Wrap" MaxLength="3" VerticalAlignment="Center" HorizontalAlignment="Left" Width="40" PreviewTextInput="TextBox_PreviewTextInput"/>
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <Button Name="buttonSave" Content="Сохранить"  Margin="10" Click="ButtonSaveUpdate_Click"/>
            <Button Name="buttonCancel" Content="Отмена" Margin="10" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
