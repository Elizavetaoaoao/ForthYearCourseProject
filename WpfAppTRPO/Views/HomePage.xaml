<Page x:Class="WpfAppTRPO.Views.HomePage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppTRPO.Views"
        mc:Ignorable="d"
      Background="#E9AFEC"
        Title="HomePage">
    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="40"/>
            <Setter Property="Foreground" Value="#9D5D91"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#FCC165"/>
            <Setter Property="Padding" Value="30"/>
            <Setter Property="Margin" Value="50"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#9D5D91"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="40"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Foreground" Value="#9D5D91"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Page.Resources>
    <Viewbox Stretch="Uniform">
    <Grid Margin="80">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1100"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Image x:Name="imageEmployeePhoto" Stretch="UniformToFill" Height="290" Width="290" VerticalAlignment="Top" HorizontalAlignment="Left" ImageFailed="ImageEmployeePhoto_ImageFailed" Margin="50,41,0,0" Source="/Views/photo.png"/>
            <TextBlock x:Name="textBlockName" Text="ФИО сотрудника" FontSize="40" FontWeight="Bold" Foreground="#9D5D91" TextWrapping="Wrap" Margin="382,123,0,620"/>
            <Label x:Name="textBlockRole" Content="Роль сотрудника" Foreground="#9D5D91" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,200,370,0"/>
            <Label x:Name="labeLog" Content="Последние действия:" Foreground="White" HorizontalContentAlignment="Left" VerticalAlignment="Top" Margin="0,351,0,0"/>
            <DataGrid x:Name="listViewLog" Background="#D37EAB" Foreground="White" VerticalAlignment="Bottom" HorizontalAlignment="Left" Height="400" Width="1000" IsReadOnly="True"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Button x:Name="buttonJournal" Content="ЖУРНАЛ" Click="ButtonJournal_Click"/>
            <Button x:Name="buttonCatalog" Content="КАТАЛОГ" Click="ButtonCatalog_Click"/>
            <Button x:Name="buttonEmployees" Content="СОТРУДНИКИ" Click="ButtonEmployees_Click"/>
            <Button x:Name="buttonReader" Content="ЧИТАТЕЛИ" Click="ButtonReaders_Click"/>
        </StackPanel>
    </Grid>
    </Viewbox>
</Page>
